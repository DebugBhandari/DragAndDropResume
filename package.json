{
  "name": "drag-and-drop-resume",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npx -y node@20.9.0 node_modules/next/dist/bin/next dev",
    "build": "npx -y node@20.9.0 node_modules/next/dist/bin/next build",
    "start": "npm run build && npx -y node@20.9.0 node_modules/next/dist/bin/next start",
    "start:prod": "npx -y node@20.9.0 node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000",
    "lint": "eslint",
    "auth:save-state": "node scripts/save-storage-state.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "next": "16.2.6",
    "nodemailer": "^8.0.10",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-to-print": "^3.3.0",
    "uuid": "^14.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
